generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id          String              @id
  name        String
  email       String              @unique
  password    String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  resetTokens PasswordResetToken[]
  orders      Order[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt, used])
}

model Order {
  id                  String          @id
  userId              String
  subtotal            Decimal?
  shippingCharge      Decimal?
  shipmentWeight      Decimal?
  packageLength       Decimal?
  packageBreadth      Decimal?
  packageHeight       Decimal?
  total               Decimal
  shippingName        String
  shippingEmail       String
  shippingPhone       String
  shippingAddress     String          @db.Text
  shippingCity        String
  shippingState       String
  shippingPincode     String
  paymentStatus       PaymentStatus
  razorpayOrderId     String          @unique
  razorpayPaymentId   String?         @unique
  invoiceNumber       String?         @unique
  invoiceGeneratedAt  DateTime?
  invoiceStatus       InvoiceStatus?
  invoiceFileName     String?
  shiprocketStatus    ShiprocketStatus?
  shiprocketOrderId   Int?
  shipmentId          Int?
  awbCode             String?
  courierCompanyId    Int?
  courierName         String?
  pickupScheduledDate DateTime?
  pickupToken         String?
  pickupStatus        Int?
  manifestGenerated   Boolean?
  manifestUrl         String?
  shiprocketError     String?         @db.Text
  shiprocketUpdatedAt DateTime?
  status              OrderStatus
  createdAt           DateTime        @default(now())

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId, createdAt])
}

model OrderItem {
  id                Int      @id @default(autoincrement())
  orderId           String
  productId         String
  name              String
  price             Decimal
  quantity          Int
  image             String
  sku               String?
  priceExcludingGst Decimal?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Review {
  id        String   @id
  productId String
  name      String
  rating    Int
  review    String   @db.Text
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
}

enum PaymentStatus {
  pending
  paid
  failed
}

enum InvoiceStatus {
  generated
  draft
}

enum ShiprocketStatus {
  pending
  created
  awb_assigned
  pickup_generated
  failed
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
}
